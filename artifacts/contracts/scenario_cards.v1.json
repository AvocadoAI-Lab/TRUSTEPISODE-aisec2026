{
  "contract_version": "trustepisode.scenario-cards.v3",
  "required_valid_repetitions_per_card_and_mode": 10,
  "achieved_repetitions": "pending",
  "safety": "two isolated Linux endpoint containers, one inline NDR gateway, manifest-resolved test accounts, fixed harmless fixtures, offline-only success receipts, and snapshot-backed cleanup",
  "execution_contract": {
    "target_shell": "/bin/bash --noprofile --norc -euo pipefail -c",
    "scheduler": "the orchestrator starts each ability at card_start_monotonic+offset_seconds with absolute error <=1 second",
    "concurrency": "one formal card run owns the target pair; only the registered concurrent-benign card may overlap",
    "collection_window": "starts 30 seconds before the earliest ability and ends after the last postcondition probe; cleanup telemetry is outside the evidence window",
    "target_identity_firewall": "run_id, card_id, ability_id, operation_id, receipt_id, split, label, and marker values are unavailable to target commands and online objects"
  },
  "template_variables": {
    "target_command_required": [
      "target",
      "test_user",
      "service_url",
      "fixture_dir",
      "package_path",
      "package_sha256",
      "remote_dir",
      "action_path",
      "remote_action_path",
      "output_path",
      "stage_dir"
    ],
    "orchestrator_only_required": ["run_id", "card_id", "ability_id", "credential_ref", "work_order_id"],
    "resolution": "resolve target variables from the frozen image/topology manifest and orchestrator variables from the sealed run manifest; unresolved or extra variables invalidate the run",
    "quoting": "UTF-8 values are passed as typed executor arguments; no value is interpolated by a second shell",
    "online_prohibition": "orchestrator-only names and values are recursively rejected before NormalizedEvent construction"
  },
  "image_contract": {
    "allowed_keys": ["ubuntu2204_edr_target_v1", "ubuntu2204_edr_service_v1"],
    "instances": {
      "edr_target_01": "ubuntu2204_edr_target_v1",
      "edr_target_02": "ubuntu2204_edr_service_v1"
    },
    "resolution": "every key resolves to OCI image digest, filesystem baseline digest, installed-package manifest digest, and endpoint-sensor configuration digest before collection",
    "reuse": "cleanup success, no remaining SSH/session/task objects, and filesystem baseline digest equality are required before reuse"
  },
  "receipt_contract": {
    "storage": "Ground Truth Store only; receipts and their preimages are never ingested by EDR, NDR, NormalizedEvent, Episode Synthesis, detectors, scorer, calibrator, sufficiency, or online outcomes",
    "receipt_id": "lowercase hex SHA-256(UTF8('TrustEpisode-receipt-v1')||0x1f||run_id||0x1f||card_id||0x1f||ability_id)",
    "content": "RFC8785({run_id,card_id,ability_id,start_monotonic_us,end_monotonic_us,exit_code,postcondition_digest})",
    "success": "ability exit_code=0, its fixed-path postcondition probe passes, and the offline receipt digest verifies",
    "postcondition_timing": "probe immediately after the ability and before cleanup; probe events are quarantined from the evidence window",
    "cleanup_success": "all fixed action/output/stage paths and temporary grants are absent and the registered filesystem baseline digest is restored"
  },
  "mode_matrix": {
    "malicious": ["attack_only", "concurrent_benign"],
    "benign": ["standalone_benign"],
    "concurrent_benign_selection": "B[1 + uint64_be(SHA-256(UTF8('20260710')||0x1f||run_id)[0:8]) mod 8]",
    "concurrent_start": "selected benign card starts exactly 60 seconds before malicious offset 0 and runs once",
    "prohibited": ["two malicious cards in one run", "unregistered background workload", "mode change after split freeze", "target command containing an orchestrator-only value"]
  },
  "ability_catalog": {
    "linux.discovery": {
      "executor": "bash_no_profile",
      "command": "hostname; id; ps -eo pid,ppid,comm --sort=pid | head -n 32"
    },
    "linux.peer_inventory": {
      "executor": "bash_no_profile",
      "command": "getent ahostsv4 '${target}'; ip route get '${target}'"
    },
    "linux.ssh_action": {
      "executor": "bash_no_profile",
      "command": "printf '%s\\n' 'TRUSTEPISODE_CONTROLLED_ACTION' | ssh -F '${fixture_dir}/ssh_config' '${test_user}@${target}' -- /usr/bin/install -D -m 0600 /dev/stdin '${remote_action_path}'"
    },
    "linux.local_action": {
      "executor": "bash_no_profile",
      "command": "install -d -m 0700 \"$(dirname '${action_path}')\"; printf '%s\\n' 'TRUSTEPISODE_CONTROLLED_ACTION' > '${action_path}'"
    },
    "linux.config_action": {
      "executor": "bash_no_profile",
      "command": "install -D -m 0644 '${fixture_dir}/registered-test.conf' '${action_path}'; cmp '${fixture_dir}/registered-test.conf' '${action_path}'"
    },
    "linux.stage_fixture": {
      "executor": "bash_no_profile",
      "command": "rm -rf -- '${stage_dir}'; install -d -m 0700 '${stage_dir}'; cp -a -- '${fixture_dir}/transfer/.' '${stage_dir}/'"
    },
    "linux.archive_fixture": {
      "executor": "bash_no_profile",
      "command": "tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner -czf '${output_path}' -C '${stage_dir}' ."
    },
    "linux.scp_archive": {
      "executor": "bash_no_profile",
      "command": "scp -F '${fixture_dir}/ssh_config' '${output_path}' '${test_user}@${target}:${remote_dir}/controlled-transfer.tar.gz'"
    },
    "linux.delayed_local_action": {
      "executor": "bash_no_profile",
      "command": "install -d -m 0700 \"$(dirname '${action_path}')\"; cp -- '${fixture_dir}/delayed-action.txt' '${action_path}'"
    },
    "net.cadence": {
      "executor": "bash_no_profile",
      "command": "for i in 1 2 3 4 5; do curl --fail --silent --show-error --output /dev/null '${service_url}/health?probe=controlled&step='$i; [ \"$i\" -eq 5 ] || sleep 60; done"
    },
    "benign.inventory": {
      "executor": "bash_no_profile",
      "command": "{ uname -a; dpkg-query -W | sort; } > '${output_path}'"
    },
    "benign.package_install": {
      "executor": "bash_no_profile",
      "command": "printf '%s  %s\\n' '${package_sha256}' '${package_path}' | sha256sum -c -; sudo dpkg --install '${package_path}'"
    },
    "benign.rsync": {
      "executor": "bash_no_profile",
      "command": "rsync -a --delete --checksum -e \"ssh -F '${fixture_dir}/ssh_config'\" '${fixture_dir}/sync/' '${test_user}@${target}:${remote_dir}/benign-sync/'"
    },
    "benign.scan": {
      "executor": "bash_no_profile",
      "command": "nmap -Pn -sT --max-retries 1 --host-timeout 120s -p 22,80,443 '${target}' -oN '${output_path}'"
    },
    "benign.helpdesk": {
      "executor": "bash_no_profile",
      "command": "ssh -F '${fixture_dir}/ssh_config' '${test_user}@${target}' -- /usr/bin/supervisorctl status trustepisode-fixture > '${output_path}'"
    },
    "benign.logs": {
      "executor": "bash_no_profile",
      "command": "tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner -czf '${output_path}' -C '${fixture_dir}' logs"
    },
    "benign.config": {
      "executor": "bash_no_profile",
      "command": "sudo install -D -m 0644 '${fixture_dir}/registered-benign.conf' '${action_path}'; cmp '${fixture_dir}/registered-benign.conf' '${action_path}'"
    },
    "benign.maintenance": {
      "executor": "bash_no_profile",
      "command": "sudo supervisorctl restart trustepisode-fixture; supervisorctl status trustepisode-fixture > '${output_path}'"
    },
    "cleanup.local": {
      "executor": "bash_no_profile",
      "command": "rm -f -- '${action_path}' '${output_path}'"
    },
    "cleanup.remote_action": {
      "executor": "bash_no_profile",
      "command": "ssh -F '${fixture_dir}/ssh_config' '${test_user}@${target}' -- rm -f -- '${remote_action_path}'"
    },
    "cleanup.stage": {
      "executor": "bash_no_profile",
      "command": "rm -rf -- '${stage_dir}'; rm -f -- '${output_path}'"
    },
    "cleanup.remote_transfer": {
      "executor": "bash_no_profile",
      "command": "ssh -F '${fixture_dir}/ssh_config' '${test_user}@${target}' -- rm -rf -- '${remote_dir}/controlled-transfer.tar.gz' '${remote_dir}/benign-sync'"
    },
    "cleanup.package": {
      "executor": "bash_no_profile",
      "command": "sudo dpkg --purge trustepisode-benign-fixture"
    },
    "cleanup.config": {
      "executor": "bash_no_profile",
      "command": "sudo rm -f -- '${action_path}'"
    }
  },
