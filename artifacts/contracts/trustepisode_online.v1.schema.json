        "U", "source_mask", "detector_observation", "health_snapshot", "resolved_detector_state",
        "eligible_detector_count", "eligibility_reason",
        "coverage_ref_ids", "health_snapshot_digest", "ordered_evidence_references", "versions"
      ],
      "x-canonical-digest-excludes": ["canonical_digest", "runtime_envelope"]
    },
    "AssemblyFailureRecord": {
